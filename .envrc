# Prefer Nix flake devShell when flakes are enabled, otherwise fall back to shell.nix.
# Both declaratively provision Node.js, node_modules, ngspice, KiCad CLI, Freerouting, and Biome.
watch_file shell.nix package.json package-lock.json

if command -v nix >/dev/null 2>&1 && nix show-config 2>/dev/null | grep -q "flakes"; then
  watch_file flake.nix flake.lock
  use flake
else
  use nix
fi

PATH_add node_modules/.bin
export TSCI_TELEMETRY_DISABLED=1
