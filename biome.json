{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "specs/**", "checks/**", "tests/**", "scripts/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  }
}
